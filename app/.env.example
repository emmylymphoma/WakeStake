# Leave VITE_CHAIN unset for the mock demo (no wallet, no real money).
# Set it to use a real wallet and the WakeStake contract. Copy to .env.local.

# sepolia | localhost
VITE_CHAIN=sepolia
# Optional: defaults to the chain's public RPC
VITE_RPC_URL=
# Optional on sepolia: defaults to ignition/deployments/chain-11155111
VITE_WAKESTAKE_ADDRESS=
# ERC20 to stake (1 token = $1 in the UI). For a test token:
#   pnpm hardhat ignition deploy ignition/modules/TestToken.ts --network sepolia
VITE_TOKEN_ADDRESS=
# Where a late stake goes (minus the contract's fee). Fixed per stake at deposit time.
VITE_DONATION_ADDRESS=
# Optional: a DonationRouter (scripts/setup-donation-router.ts). Replaces VITE_DONATION_ADDRESS:
# late stakes go to the router, and the app swaps them on Uniswap into the charity's token.
VITE_DONATION_ROUTER=
# Optional: Uniswap pool fee tier (default 3000 = 0.3%) and QuoterV2 (default: Sepolia's)
VITE_UNISWAP_POOL_FEE=
VITE_UNISWAP_QUOTER=
# 1 = mint yourself test tokens when your balance is too low (MockERC20 only)
VITE_MINT_TEST_TOKENS=1
