# From @BotFather (/newbot)
BOT_TOKEN=

# Base URL of the claim page; the bot links to $DAPP_URL/claim?stake=<id>
DAPP_URL=https://wakestake.example

# Contract watcher (optional until the contract is deployed)
RPC_URL=
WAKESTAKE_ADDRESS=

# Optional: comma-separated group chat ids to always notify
GROUP_CHAT_IDS=

# 1 = enables /testslash in groups
DEV_MODE=0
